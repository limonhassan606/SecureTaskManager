{
  "name": "securetask-manager",
  "version": "1.0.0",
  "description": "Advanced Process Manager with VirusTotal Integration",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win --x64 portable",
    "build:all": "electron-builder --win --x64 --ia32"
  },
  "keywords": [
    "process-manager",
    "virustotal",
    "security",
    "task-manager"
  ],
  "author": {
    "name": "LIMON HASAN",
    "email": "limonhassan606@gmail.com"
  },
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.limonhassan606.securetask",
    "productName": "SecureTask Manager",
    "copyright": "Copyright © 2026 LIMON HASAN",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SecureTask Manager"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^32.2.10",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chart.js": "^4.4.7",
    "crypto-js": "^4.2.0",
    "nedb-promises": "^6.2.3",
    "systeminformation": "^5.23.18"
  }
}